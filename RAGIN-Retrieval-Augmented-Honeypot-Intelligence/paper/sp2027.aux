\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Live-campaign results from the persisted artifacts (identical deterministic-strata bars across runs are the finding, not a plotting error). All four plotted values are the \emph  {both-channel} operational score of Table~\ref {tab:live}, which fuses the served-text and CTI-analysis channels; they are not served-quality results, and the echo-guarded bounds for the same rows are 0.479 technique and 0.243 actor. \emph  {Top:} suite means with bootstrap 95\% confidence intervals; open markers mark the independent second run's point estimates, and the actor interval is degenerate ($^{\dagger }$) because the actor rubric assigns the same score to every row, so uncertainty is carried by the Wilson pass-rate interval instead (Table~\ref {tab:live}). \emph  {Bottom:} two independent 218-query campaigns; the deterministic CTI strata replicate exactly and only the LLM-judged persona stratum moves, by $+0.018$.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:results}{{3}{9}{Live-campaign results from the persisted artifacts (identical deterministic-strata bars across runs are the finding, not a plotting error). All four plotted values are the \emph {both-channel} operational score of Table~\ref {tab:live}, which fuses the served-text and CTI-analysis channels; they are not served-quality results, and the echo-guarded bounds for the same rows are 0.479 technique and 0.243 actor. \emph {Top:} suite means with bootstrap 95\% confidence intervals; open markers mark the independent second run's point estimates, and the actor interval is degenerate ($^{\dagger }$) because the actor rubric assigns the same score to every row, so uncertainty is carried by the Wilson pass-rate interval instead (Table~\ref {tab:live}). \emph {Bottom:} two independent 218-query campaigns; the deterministic CTI strata replicate exactly and only the LLM-judged persona stratum moves, by $+\RaginPersonaRunDelta $}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Paired grounding ablation: 90 matched scenario pairs. Scores are the declared analysis-channel composite; channel attribution follows the recorded scorer configuration and measurement lineage, as the archived artifact carries no channel field. CIs are paired bootstrap intervals. The archived artifact pairs by scenario name; new reruns must persist canonical scenario IDs and manifest hashes.}}{9}{table.3}\protected@file@percent }
\newlabel{tab:b4}{{3}{9}{Paired grounding ablation: 90 matched scenario pairs. Scores are the declared analysis-channel composite; channel attribution follows the recorded scorer configuration and measurement lineage, as the archived artifact carries no channel field. CIs are paired bootstrap intervals. The archived artifact pairs by scenario name; new reruns must persist canonical scenario IDs and manifest hashes}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Paired grounding differential (RAG $-$ No-RAG) per suite with 95\% bootstrap CIs over 90 scenario pairs (numbers in Table~\ref {tab:b4}). Filled markers: intervals excluding zero -- $+0.317$ on technique detection and $+0.140$ on actor attribution. The open marker is the persona stratum, whose interval straddles zero exactly as the architecture predicts: host believability is produced by the deception engine and the fiction graph, not by threat-intelligence retrieval. The mechanism behind the technique effect is starker than the mean: the grounded arm yields 35{} TTP detections spanning 21 distinct techniques, while the ungrounded arm yields none.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:grounding}{{4}{9}{Paired grounding differential (RAG $-$ No-RAG) per suite with 95\% bootstrap CIs over 90 scenario pairs (numbers in Table~\ref {tab:b4}). Filled markers: intervals excluding zero -- $+\RaginTechDelta $ on technique detection and $+\RaginActorDelta $ on actor attribution. The open marker is the persona stratum, whose interval straddles zero exactly as the architecture predicts: host believability is produced by the deception engine and the fiction graph, not by threat-intelligence retrieval. The mechanism behind the technique effect is starker than the mean: the grounded arm yields \RaginGroundingTtpCount {} TTP detections spanning 21 distinct techniques, while the ungrounded arm yields none}{figure.4}{}}
