{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human_annotation_schema_v1",
  "title": "Human annotation output schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rater_id",
    "annotation_protocol_version",
    "packet_sha256",
    "items"
  ],
  "properties": {
    "rater_id": {
      "type": "string",
      "pattern": "^human_rater_0[1-3]$"
    },
    "annotation_protocol_version": {
      "const": "human_v1"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 120,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "label",
          "note"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": [
              "BENIGN",
              "RECON",
              "SUSPICIOUS",
              "EXPLOITATION",
              "PRIVILEGE_ESCALATION",
              "DATA_ACCESS",
              "PERSISTENCE",
              "OTHER_ATTACK",
              "UNCERTAIN"
            ],
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "x-validation": [
    "items must contain the identical frozen 120-case ID set exactly once",
    "labels must be non-blank and members of the frozen taxonomy"
  ]
}
