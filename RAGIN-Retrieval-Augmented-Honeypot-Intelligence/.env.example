# Copy to .env and fill in real values. .env is gitignored — never commit it.
# API key required by the nginx /v1/ auth map. Injected via envsubst at container start.
RAGIN_API_KEY=ragin-<generate-a-new-random-hex-key>

# No paid/provider API key is required for the tested local OpenCode bridge.
# Do not place an OpenCode credential or private key in this file.
OPENROUTER_API_KEY=

# API key checked by the RAGIN server's own X-API-Key auth middleware
# (server.py / server_v2.py). Leave empty to disable auth (development only).
API_KEY=ragin-<generate-a-new-random-hex-key>

# Primary LLM backend for Don/Hisoka + human eval (OpenAI-compatible).
# Canonical vars: RAGIN_LLM_BASE_URL (base incl. /v1), RAGIN_LLM_API_KEY,
# RAGIN_LLM_MODEL. Legacy AZURE_OPENAI_* / EVAL_GATEWAY_URL are still read
# by the scripts as fallbacks.
RAGIN_LLM_BASE_URL=http://127.0.0.1:8731/v1
RAGIN_LLM_API_KEY=loopback-test
RAGIN_LLM_MODEL=opencode/space-bunny-free

# Optional transport style (default "chat" = /v1/chat/completions).
# Set to "responses" only for providers that route their current models
# through the OpenAI Responses API and reject chat/completions for them;
# the client translates at the transport boundary and the observation ledger
# records the payload that actually went on the wire.
RAGIN_LLM_API_STYLE=chat

# Optional User-Agent override. Some gateways answer only requests that
# identify as one of their supported clients; leave empty (default) to send
# requests' own User-Agent. Set only if your provider requires it and your
# account is allowed to use it — check the provider's terms first.
# Quote the value: UA strings contain spaces and parentheses, and an unquoted
# value breaks any shell that sources this file (python-dotenv tolerates it,
# `set -a; . ./.env` does not — the variable silently ends up empty and every
# probe gets 401 "unauthorized client detected").
RAGIN_LLM_USER_AGENT=
# Engine model override for benchmark_fullcorpus_graph.py (BENCH_ENGINE_MODEL
# takes precedence). glm-5.3-flash is a reasoning family — tune via
# reasoning_effort=low (handled automatically for short calls).
BENCH_ENGINE_MODEL=opencode/space-bunny-free

# Grafana admin password for the monitoring stack.
GRAFANA_ADMIN_PASSWORD=<generate-a-new-random-password>

# Service ports / infrastructure (server_v2 component mode)
GATEWAY_PORT=8080
CHROLLO_PORT=8001
DON_PORT=8002
HISOKA_PORT=8003
REDIS_URL=redis://localhost:6379/0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# LLM cost guardrails (CostTracker budgets, USD)
MONTHLY_BUDGET_USD=2000
DAILY_BUDGET_USD=100

# Optional: bind host for the RAGIN management API. Default 127.0.0.1;
# set 0.0.0.0 ONLY when fronted by the nginx gateway with auth.
RAGIN_BIND_HOST=127.0.0.1

# Optional: salt for hash_ip() privacy hashing. Override with a secret
# value in production; the default keeps hashes reproducible for research.
RAGIN_IP_SALT=ragin-ip-v1

# Host key for the protected audit log (ragin/cycle/containment/audit_integrity.py).
# No default: a published key would make audit-row signatures forgeable, so the
# signer refuses to run without one (previously published defaults are rejected).
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
RAGIN_AUDIT_HOST_KEY=

# Don RAG orchestration: LangGraph corrective-RAG graph (1, default) or
# legacy single-shot analyze() (0). The graph degrades gracefully to
# deterministic heuristics when the LLM gateway is unavailable.
RAGIN_DON_GRAPH=1

# Jev System One behavior-key model — typed answers (noul/choice/score) via
# the beatapi Decisions API (TypeSafe-compatible; /v1/decisions is an alias).
# Free tier: jev-1.14-free is $0 but rate-limited to 1 request/minute/account.
#   RAGIN_JEVI_BASE_URL  https://api.beatapi.io/v1
#   RAGIN_JEVI_API_KEY   your beatapi key (required — no public tier)
#   RAGIN_JEVI_MODEL     jev-1.14-free
#   RAGIN_JEVI_ENABLED   1 (set 0 to disable Jev entirely)
RAGIN_JEVI_BASE_URL=https://api.beatapi.io/v1
RAGIN_JEVI_API_KEY=replace-with-real-beatapi-key
RAGIN_JEVI_MODEL=jev-1.14-free
RAGIN_JEVI_ENABLED=1

# Optional port overrides
HISOKA_DECEPTION_PORT=2222
COWRIE_PORT=2223
