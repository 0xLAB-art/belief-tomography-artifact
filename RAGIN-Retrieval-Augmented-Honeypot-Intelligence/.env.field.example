# Field endpoint environment — copy to .env.field and fill per endpoint.
# NEVER commit .env.field. Values here are placeholders; the field arms carry
# only synthetic/decoy credentials by design (see docs/FIELD_ETHICS.md §2).

# Which arm this endpoint serves (must match field_provision.sh argument)
RAGIN_FIELD_ARM=ragin

# Public identity of the honeypot listener (synthetic decoy credentials only)
RAGIN_FIELD_SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4

# LLM backend (RAGIN + vanilla arms; cowrie arm ignores these).
# This is intentionally an unresolved placeholder: the local loopback bridge
# cannot be addressed from a container without an explicitly approved private
# transport. Do not replace it with a paid provider by default.
RAGIN_LLM_BASE_URL=replace-with-approved-private-bridge/v1
RAGIN_LLM_API_KEY=replace-me
RAGIN_LLM_MODEL=opencode/space-bunny-free

# Egress allowlist host provisioned into DOCKER-USER (scripts/field_provision.sh)
RAGIN_LLM_PROVIDER_HOST=replace-with-approved-private-bridge

# Collection endpoint (optional): push hashed exports to the analysis host
RAGIN_FIELD_COLLECT_URL=

# Image for the ragin/vanilla arms
RAGIN_IMAGE=ghcr.io/0xzodiac/the-intelligence-ladder:latest

# Internal-net backend auth: the cowrie-llm frontend's COWRIE_LLM_API_KEY must
# equal this (backend services reject other callers). Generate per endpoint:
#   python -c "import secrets; print(secrets.token_hex(24))"
BACKEND_API_KEY=replace-me-backend-key

# Arm B/C only: which backend the shared cowrie-llm frontend calls.
#   vanilla endpoint: http://bare-llm:8084
#   ragin endpoint:   http://ragin-server:8083
COWRIE_LLM_HOST=http://bare-llm:8084
