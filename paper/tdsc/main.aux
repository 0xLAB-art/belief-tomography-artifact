\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces External baselines on the 218-query workload (generator: deepseek-v4-flash-free for all LLM arms). \textbf  {All scores are served-text channel under the raw (pre-guard) rubric}---the deception quality an attacker experiences. Paired per-row deltas are scorer-invariant: the verified loop serves byte-identical strings to the no-verifier arm on all 218 rows (paired delta 0.000), and the host-fiction layer adds cross-session consistency at exactly zero quality cost (paired per-row delta 0.000). Absolute levels on fallback-heavy runs shift under the echo guard (Table~\ref {tab:two-channel}); the grounding and consistency contrasts do not.}}{18}{table.7}\protected@file@percent }
\newlabel{tab:baseline-served-text}{{VII}{18}{External baselines on the 218-query workload (generator: deepseek-v4-flash-free for all LLM arms). \textbf {All scores are served-text channel under the raw (pre-guard) rubric}---the deception quality an attacker experiences. Paired per-row deltas are scorer-invariant: the verified loop serves byte-identical strings to the no-verifier arm on all 218 rows (paired delta 0.000), and the host-fiction layer adds cross-session consistency at exactly zero quality cost (paired per-row delta 0.000). Absolute levels on fallback-heavy runs shift under the echo guard (Table~\ref {tab:two-channel}); the grounding and consistency contrasts do not}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Blinded annotator audit of the automated scorers (\S  \ref {sec:scorer-audit}): two independent blinded annotators (fixed-identity free-tier models, no gold labels, no pipeline scores), third-annotator adjudication, taxonomy pinned to \\attck{} Enterprise v19.1 (vendored STIX, sha256-locked). Scorer-vs-annotator agreement is Cohen's $\kappa $ between the automated channel verdicts and the adjudicated annotator labels, before/after the echo guard. All disagreements were adjudicated; none unresolved.}}{18}{table.8}\protected@file@percent }
\newlabel{tab:cti-audit}{{VIII}{18}{Blinded annotator audit of the automated scorers (\S \ref {sec:scorer-audit}): two independent blinded annotators (fixed-identity free-tier models, no gold labels, no pipeline scores), third-annotator adjudication, taxonomy pinned to \\attck{} Enterprise v19.1 (vendored STIX, sha256-locked). Scorer-vs-annotator agreement is Cohen's $\kappa $ between the automated channel verdicts and the adjudicated annotator labels, before/after the echo guard. All disagreements were adjudicated; none unresolved}{table.8}{}}
