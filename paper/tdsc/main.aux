\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The intelligence ladder. Each rung is admitted only above the certifiable rungs beneath it, and each rung carries its measured marginal effect (\S  \ref {sec:evaluation}). The dashed arrow is the result RQ4 adds: the assessed kind-awareness rung descended to the deterministic floor -- no effect the benchmark resolves, no regression risk, no provider dependency. Descending is the load-bearing direction; a rung that cannot show a measurable benefit above the rung below it does not stay on the ladder.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:ladder}{{1}{6}{The intelligence ladder. Each rung is admitted only above the certifiable rungs beneath it, and each rung carries its measured marginal effect (\S \ref {sec:evaluation}). The dashed arrow is the result RQ4 adds: the assessed kind-awareness rung descended to the deterministic floor -- no effect the benchmark resolves, no regression risk, no provider dependency. Descending is the load-bearing direction; a rung that cannot show a measurable benefit above the rung below it does not stay on the ladder}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-B}}Session Profiling: Behavioral Classification}{6}{subsection.3.2}\protected@file@percent }
