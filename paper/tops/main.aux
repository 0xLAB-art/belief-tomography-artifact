\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces E5: onset regimes on constructed planes (all frozen values). Detection AUC of the two-sample statistic vs.\ fresh-sample horizon $M$; one panel per footprint $\delta $. Solid curves memorize a reference batch ($N_0=10$, $N_0=40$); the dashed curve is the birth-onset self-test ($N_0=0$), whose registered ``flat at chance'' prediction failed: it reads $0.431$--$0.529$ at $\delta =0.2$ (two of the four readings below chance) and $0.339$--$0.439$ at $\delta =0.4$, up to $0.16$ \emph  {below} chance (a small-sample asymmetry of the studentized statistic: with $N_0=0$ the reference stream doubles as the first half of the $M$-sample draw, so the lattice of the score's null distribution sits a half step below chance at short $M$, and the plug-in variance from the same path is conservative by design of the two-sample plug-in). Plateaus: $(10,0.2)$ flat at $0.69$--$0.74$, $19$--$24$ points above chance; $(40,0.2)$ rising to $0.97$; $(10,0.4)$ non-monotone $0.91$--$0.97$; $(40,0.4)$ $0.92\to 1.000$. The corrected boundary $\Delta _{\beta _d}=1.84\rho _0$ orders the extremes; the shaded band marks the $N_0=10$ reference-width regime.}}{15}{figure.caption.8}\protected@file@percent }
\newlabel{fig:onset}{{2}{15}{E5: onset regimes on constructed planes (all frozen values). Detection AUC of the two-sample statistic vs.\ fresh-sample horizon $M$; one panel per footprint $\delta $. Solid curves memorize a reference batch ($N_0=10$, $N_0=40$); the dashed curve is the birth-onset self-test ($N_0=0$), whose registered ``flat at chance'' prediction failed: it reads $0.431$--$0.529$ at $\delta =0.2$ (two of the four readings below chance) and $0.339$--$0.439$ at $\delta =0.4$, up to $0.16$ \emph {below} chance (a small-sample asymmetry of the studentized statistic: with $N_0=0$ the reference stream doubles as the first half of the $M$-sample draw, so the lattice of the score's null distribution sits a half step below chance at short $M$, and the plug-in variance from the same path is conservative by design of the two-sample plug-in). Plateaus: $(10,0.2)$ flat at $0.69$--$0.74$, $19$--$24$ points above chance; $(40,0.2)$ rising to $0.97$; $(10,0.4)$ non-monotone $0.91$--$0.97$; $(40,0.4)$ $0.92\to 1.000$. The corrected boundary $\Delta _{\beta _d}=1.84\rho _0$ orders the extremes; the shaded band marks the $N_0=10$ reference-width regime}{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The registered E5 prediction versus the corrected boundaries (exploratory, post hoc; $\beta _d=0.05$ two-sided; $p=0.30$; $\rho _0=z_{1-\beta _d/2}\sqrt  {p(1-p)/N_0}=0.284/0.142$; $\Delta _{\beta _d}=(z_{1-\beta _d/2}+z_{1-\beta _d})\sigma _0=1.84\rho _0=0.522/0.261$; non-adaptive width $w_{\mathrm  {na}}=\sqrt  {2\ln (1/\beta _d)/N_0}=0.774/0.387$; observed values frozen, all four $M$ points per cell). The registered prediction (``advantage $\to 1$ above the floor; flat at chance'') failed at three cells (Section\nonbreakingspace \ref {sec:e5}); the corrected trichotomy orders the extremes and leaves the two middle cells overlapping plateaus below certified power (limiting TPR $0.79$ normal; the one-sided exact binomial UMP has power $0.850$ at $(10,0.4)$ and $0.807$ at $(40,0.2)$).}}{15}{table.caption.10}\protected@file@percent }
\newlabel{tab:widths}{{2}{15}{The registered E5 prediction versus the corrected boundaries (exploratory, post hoc; $\beta _d=0.05$ two-sided; $p=0.30$; $\rho _0=z_{1-\beta _d/2}\sqrt {p(1-p)/N_0}=0.284/0.142$; $\Delta _{\beta _d}=(z_{1-\beta _d/2}+z_{1-\beta _d})\sigma _0=1.84\rho _0=0.522/0.261$; non-adaptive width $w_{\mathrm {na}}=\sqrt {2\ln (1/\beta _d)/N_0}=0.774/0.387$; observed values frozen, all four $M$ points per cell). The registered prediction (``advantage $\to 1$ above the floor; flat at chance'') failed at three cells (Section~\ref {sec:e5}); the corrected trichotomy orders the extremes and leaves the two middle cells overlapping plateaus below certified power (limiting TPR $0.79$ normal; the one-sided exact binomial UMP has power $0.850$ at $(10,0.4)$ and $0.807$ at $(40,0.2)$)}{table.caption.10}{}}
