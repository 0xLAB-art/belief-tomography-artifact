\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces E2-v1 --- measured family profiles and Belief--Claim Gap for both models after the preregistered token-budget repair. Runs with $\ge 50\%$ mapped-unavailable turns are excluded rather than drawn as zero profiles, because the conservative mapping manufactures safe verdicts on censored turns. Per-family $\hat  \beta =0$ with Wilson 95\% CI $[0,0.060]$; the interval, not the point estimate, is the result.}}{9}{figure.caption.19}\protected@file@percent }
\newlabel{fig:field}{{4}{9}{E2-v1 --- measured family profiles and Belief--Claim Gap for both models after the preregistered token-budget repair. Runs with $\ge 50\%$ mapped-unavailable turns are excluded rather than drawn as zero profiles, because the conservative mapping manufactures safe verdicts on censored turns. Per-family $\hat \beta =0$ with Wilson 95\% CI $[0,0.060]$; the interval, not the point estimate, is the result}{figure.caption.19}{}}
