\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces E6/E7 --- the limits of certification. \emph  {Left}: both components certify locally at $\hat  \beta =0$, but the interface carries the retriever's secret into the orchestrator and the pipeline breaches at $\hat  \beta =1.0$. \emph  {Right}: the probe-aware foil passes public certification and fails the held-out paraphrases; the two controls show that a small gaming gap must be paired with a low $\hat  \beta $ on both probe sets.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:limits}{{6}{8}{E6/E7 --- the limits of certification. \emph {Left}: both components certify locally at $\hat \beta =0$, but the interface carries the retriever's secret into the orchestrator and the pipeline breaches at $\hat \beta =1.0$. \emph {Right}: the probe-aware foil passes public certification and fails the held-out paraphrases; the two controls show that a small gaming gap must be paired with a low $\hat \beta $ on both probe sets}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces E7 --- the gaming gap at 20 probes/cell, mean over five families. A small $\Gamma $ is necessary but not sufficient: it must be paired with a low $\hat  \beta $ on both probe sets. $^\dagger $Control foil.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:gaming}{{2}{8}{E7 --- the gaming gap at 20 probes/cell, mean over five families. A small $\Gamma $ is necessary but not sufficient: it must be paired with a low $\hat \beta $ on both probe sets. $^\dagger $Control foil}{table.2}{}}
